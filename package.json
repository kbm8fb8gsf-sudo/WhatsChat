{
  "name": "whatschat",
  "version": "0.1.0",
  "description": "SillyTavern add-on: chat with your SillyTavern characters over WhatsApp.",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p extension/jsconfig.json",
