  "description": "SillyTavern add-on: long-term memory for your characters, stored as a graphify knowledge graph.",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
